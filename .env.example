# Copy this file to `.env` and edit the values.
# Used by `docker compose` when deploying on the VPS (not needed for local dev).

# Strong password you'll type in the app (single-user login for now).
APP_PASSWORD=change-me-to-a-long-random-string

# The DuckDNS subdomain you create (see README deploy section).
DOMAIN=remindly.duckdns.org

# Contact address embedded in push messages (should be a real email you own).
VAPID_MAILTO=mailto:muhd.muhazerin@gmail.com
